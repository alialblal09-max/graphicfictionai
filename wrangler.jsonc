{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graphicfictionai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "."
  },
  "ai": {
    "binding": "AI"
  },
  "images": {
    "binding": "IMAGES"
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "graphicfiction_ai_usage"
    }
  ]
}
